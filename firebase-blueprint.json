{
  "collections": [
    {
      "name": "users",
      "description": "Stores user settings for the financial planner.",
      "documentId": "{uid}",
      "fields": [
        { "name": "monthlyIncome", "type": "number", "description": "Monthly income" },
        { "name": "monthlyLivingExpenses", "type": "number", "description": "Monthly living expenses" },
        { "name": "targetDebtToIncomeRatio", "type": "number", "description": "Target DTI" }
        { "name": "dailyExpenseBudget", "type": "number", "description": "Global daily expense budget" }
      ]
    },
    {
      "name": "dailyExpenses",
      "description": "Stores daily expense logs.",
      "documentId": "{expenseId}",
      "fields": [
        { "name": "userId", "type": "string", "description": "Owner of the record" },
        { "name": "date", "type": "string", "description": "Date in YYYY-MM-DD" },
        { "name": "type", "type": "string", "description": "expense or income" },
        { "name": "amount", "type": "number", "description": "Amount spent" },
        { "name": "note", "type": "string", "description": "Note about the expense" },
        { "name": "createdAt", "type": "timestamp", "description": "Creation time" }
      ]
    },
    {
      "name": "debts",
      "description": "Stores individual debt records.",
      "documentId": "{debtId}",
      "fields": [
        { "name": "userId", "type": "string", "description": "Owner of the debt" },
        { "name": "name", "type": "string", "description": "Name of the debt" },
        { "name": "type", "type": "string", "description": "Debt type (credit_card, mortgage, etc.)" },
        { "name": "accountNumber", "type": "string", "description": "Credit card or account number" },
        { "name": "principal", "type": "number", "description": "Original principal amount" },
        { "name": "annualInterestRate", "type": "number", "description": "Annual interest rate" },
        { "name": "termMonths", "type": "number", "description": "Term in months" },
        { "name": "startDate", "type": "string", "description": "Start date in YYYY-MM-DD" },
        { "name": "notes", "type": "string", "description": "User notes about this debt" },
        { "name": "isDeferred", "type": "boolean", "description": "Whether the debt is deferred/low priority" },
        { "name": "overdueDays", "type": "number", "description": "Number of days the loan is overdue" },
        { "name": "createdAt", "type": "timestamp", "description": "Creation time" }
      ]
    }
  ]
}
